# Copy to .env and fill in. This file covers how this instance authenticates and
# where it runs; everything about what the bot does lives in Postgres.

# --- Credentials. ---
DISCORD_TOKEN=
TEST_DISCORD_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_WEBHOOK_SECRET=

# --- Where this instance runs. ---

# Railway's postgresql:// URL works as-is; db.config rewrites the driver.
DATABASE_URL=

# EventSub callback host. Differs per instance, so not database material.
APP_URL=

# Optional: set to 1 to log every SQL statement.
DB_ECHO=
