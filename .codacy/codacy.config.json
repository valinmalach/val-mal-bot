{
  "version": 1,
  "metadata": {
    "source": "local",
    "languages": ["Python", "Shell", "Dockerfile"]
  },
  "tools": [
    {
      "toolId": "Ruff",
      "useLocalConfigurationFile": false,
      "patterns": [
        { "patternId": "Ruff_F401_unused-import" },
        { "patternId": "Ruff_F811_redefined-while-unused" },
        { "patternId": "Ruff_F841_unused-variable" },
        { "patternId": "Ruff_F821_undefined-name" },
        { "patternId": "Ruff_B006_mutable-argument-default" },
        { "patternId": "Ruff_B007_unused-loop-control-variable" },
        { "patternId": "Ruff_B018_useless-expression" },
        { "patternId": "Ruff_S101_assert" },
        { "patternId": "Ruff_S102_exec-builtin" },
        { "patternId": "Ruff_S103_bad-file-permissions" },
        { "patternId": "Ruff_S105_hardcoded-password-string" },
        { "patternId": "Ruff_S106_hardcoded-password-func-arg" },
        { "patternId": "Ruff_S107_hardcoded-password-default" },
        { "patternId": "Ruff_S108_hardcoded-temp-file" },
        { "patternId": "Ruff_S110_try-except-pass" },
        { "patternId": "Ruff_S301_suspicious-pickle-usage" },
        { "patternId": "Ruff_S608_hardcoded-sql-expression" },
        { "patternId": "Ruff_ANN001_missing-type-function-argument" },
        { "patternId": "Ruff_ANN201_missing-return-type-undocumented-public-function" }
      ]
    },
    {
      "toolId": "Trivy",
      "patterns": [
        { "patternId": "Trivy_malicious_packages" },
        { "patternId": "Trivy_secret" },
        { "patternId": "Trivy_vulnerability_critical" },
        { "patternId": "Trivy_vulnerability_high" }
      ]
    },
    {
      "toolId": "shellcheck",
      "patterns": [
        { "patternId": "shellcheck_SC2002" },
        { "patternId": "shellcheck_SC2004" },
        { "patternId": "shellcheck_SC2006" },
        { "patternId": "shellcheck_SC2034" },
        { "patternId": "shellcheck_SC2046" },
        { "patternId": "shellcheck_SC2064" },
        { "patternId": "shellcheck_SC2086" },
        { "patternId": "shellcheck_SC2116" },
        { "patternId": "shellcheck_SC2148" },
        { "patternId": "shellcheck_SC2155" },
        { "patternId": "shellcheck_SC2162" },
        { "patternId": "shellcheck_SC2164" },
        { "patternId": "shellcheck_SC2181" },
        { "patternId": "shellcheck_SC2229" }
      ]
    },
    {
      "toolId": "Hadolint",
      "patterns": [
        { "patternId": "Hadolint_DL3006" },
        { "patternId": "Hadolint_DL3007" },
        { "patternId": "Hadolint_DL3008" },
        { "patternId": "Hadolint_DL3009" },
        { "patternId": "Hadolint_DL3018" },
        { "patternId": "Hadolint_DL3025" },
        { "patternId": "Hadolint_DL3028" },
        { "patternId": "Hadolint_DL4006" }
      ]
    }
  ],
  "exclude": [
    "**/.venv/**",
    "**/__pycache__/**",
    "**/.git/**",
    "**/.ruff_cache/**",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**"
  ]
}
